{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/.env", "destination": "/404", "permanent": false },
    { "source": "/api/:path*", "destination": "/404", "permanent": false },
    { "source": "/swagger:path*", "destination": "/404", "permanent": false },
    { "source": "/swagger-ui:path*", "destination": "/404", "permanent": false },
    { "source": "/openapi.json", "destination": "/404", "permanent": false },
    { "source": "/graphql", "destination": "/404", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
