# SPA static host for Cloud Run (LISTEN_PORT comes from Cloud Run's $PORT).
server {
    listen ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~* ^/(assets/.*\.(?:js|css)|.*\.(?:js|css|png|jpg|jpeg|webp|gif|ico|svg|woff2?))$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
