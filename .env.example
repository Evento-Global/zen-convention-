# =============================================================================
# Evento Global — environment template (PUBLIC examples only — no secrets)
# =============================================================================
# Copy to `.env` for local overrides. Never commit `.env` (gitignored).
#
# Vite only exposes variables prefixed with VITE_ to the CLIENT bundle — treat
# every VITE_* value as PUBLIC. Never put API keys or service tokens in VITE_*.
#
# Hosting (Vercel / GCP / Netlify): set vars in that platform’s dashboard, not
# in the repo.
# =============================================================================

# Optional — only if code reads import.meta.env.VITE_SITE_URL (not used today)
VITE_SITE_URL=

# Optional — only if you add a footer / contact CTAs that read this at build time
VITE_CONTACT_EMAIL=
